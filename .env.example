# ---------------------------------------------------------------------------
# Copy to .env.local for development, and set the same keys in Vercel for prod.
# Never commit .env.local — it is gitignored.
# ---------------------------------------------------------------------------

# REQUIRED to go live: the pump.fun mint address for ATTENTION.
# Until this is set the site runs in preview mode — every page renders, but
# balances cannot be read, so nobody is marked eligible and the terminal stays
# locked. This is public (it ships to the browser) and that is fine.
NEXT_PUBLIC_ATTENTION_MINT=

# pump.fun mints are 6 decimals. Only change this if the token migrates.
NEXT_PUBLIC_ATTENTION_DECIMALS=6

# REQUIRED in production: 32+ random characters. Signs session cookies and
# sign-in challenges. Generate with:  openssl rand -base64 32
# Changing it logs everyone out.
SESSION_SECRET=

# Server-only RPC endpoint. The public endpoint is heavily rate limited and
# will fail under any real traffic — use Helius, Triton or QuickNode.
# Deliberately NOT prefixed NEXT_PUBLIC_: that would leak your API key to
# every visitor.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Public links shown in the nav and footer. Leave blank to hide the link.
NEXT_PUBLIC_X_URL=https://x.com/
NEXT_PUBLIC_PUMPFUN_URL=

# Where ad-slot enquiries go (a URL: x.com DM link, mailto:, Telegram).
NEXT_PUBLIC_AD_CONTACT=

# Sold ad placements as a JSON array. endsAt is epoch milliseconds.
# ADS_JSON=[{"slot":"banner","advertiser":"Someone","headline":"Headline","body":"Copy","href":"https://example.com","endsAt":1800000000000}]

# Admin key for /api/epoch (the automated holder-scan + payout sheet).
# 16+ random chars; without it the endpoint stays disabled (503).
ADMIN_KEY=
