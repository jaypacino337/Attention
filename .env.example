# Copy to .env.local for dev; set the same keys in Vercel for production.
# Never commit .env.local (gitignored). Nothing here is a wallet key: keys only
# ever live in the Railway payout services (deploy/RAILWAY.md).

# ── Storage (𝕏 caller registry) ───────────────────────────────────────────────
# Set both → Supabase (required on Vercel; run supabase/schema.sql once).
# Unset   → JSON files in ATTENTION_DATA_DIR (default ./.data), dev / single server.
# On Vercel without these, linking is disabled rather than silently losing data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ATTENTION_DATA_DIR=./.data

# ── Chain ─────────────────────────────────────────────────────────────────────
# Server-only (never NEXT_PUBLIC_). Used for balance checks, the sweep and live
# stats. The public endpoint works for those but rate-limits; the holder
# leaderboard on /terminal needs a dedicated RPC (Helius/Triton/QuickNode).
SOLANA_RPC_URL=

# ── Public identity (defaults are the launched token; override only if it changes)
# NEXT_PUBLIC_ATTENTION_MINT=CSL5S49M4RBJZuvm289x4Mt7AtSsprWmZe7ne3Xppump
# NEXT_PUBLIC_X_HANDLE=Attn_Markets_        # the account every callout must @mention
# NEXT_PUBLIC_SITE_URL=https://attnmarkets.fun
# NEXT_PUBLIC_X_URL=
# NEXT_PUBLIC_PUMPFUN_URL=

# ── Ads (/advertise) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_AD_CONTACT=
# ADS_JSON=[{"slot":"banner","advertiser":"Someone","headline":"Headline","body":"Copy","href":"https://example.com","endsAt":1800000000000}]
